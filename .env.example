# Copy to .env and replace values locally. Never commit .env.
# Do not paste credentials into issues, logs, command history, or benchmark artifacts.

# Managed CognoDB c0
COGNODB_URI=
COGNODB_USERNAME=
COGNODB_PASSWORD=

# Managed Neo4j AuraDB Free
AURA_URI=
AURA_USERNAME=
AURA_PASSWORD=

# Local containers (safe development defaults only)
LOCAL_NEO4J_URI=bolt://localhost:7687
MEMGRAPH_URI=bolt://localhost:7688
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
ARANGODB_URL=http://localhost:18529
